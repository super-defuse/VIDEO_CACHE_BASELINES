# Python bytecode and test tooling
__pycache__/
*.py[cod]
.pytest_cache/

# Local environments and editor files
.venv/
venv/
.env
.env.*
.idea/
.vscode/

# Downloaded model weights and large tensor/checkpoint payloads
/models/
/models
*.pt
*.pth
*.ckpt
*.safetensors
*.bin
*.latent

# Regenerable runtime caches. Keep run outputs, reports, and videos tracked.
artifacts/cache/
**/cache/
artifacts/vbench-cache/

# Native retrieval indices and full calibration runs are local, regenerable
# source/video/tensor payloads. Publish their compact inputs and summaries.
artifacts/cross_request_retrieval/indices/
artifacts/cross_request_retrieval/carnator_sources/
artifacts/cross_request_retrieval/benchmark.log
artifacts/cross_request_retrieval/benchmark.pid

# Full shared cross-request payloads are local and regenerable; keep manifests.
artifacts/shared_cross_request_cache/*/entries/
# A selected view may expose the same payloads through nested relative links.
# Keep the compact view manifest/index, but never commit these link farms.
artifacts/shared_cross_request_cache/*/cached_requests_*/entries/
artifacts/shared_cross_request_cache/*/cached_requests_*/source_requests.csv
artifacts/shared_cross_request_cache/*/cached_requests_*/excluded_requests.csv
artifacts/shared_cross_request_cache/*/workers/
artifacts/shared_cross_request_cache/*/full_run.log
artifacts/early_signature_color_v1_calibration_cluster_02_2170/runs/

# The generation manifest is the durable status record; worker logs are
# append-only operational history and are regenerated by the five workers.
artifacts/vidprom_1000cache_300input/early_signature_generation/worker-*.jsonl

# Keep compact VidProM result audits and summary tables, but not regenerable
# videos, evaluator payloads, caches, or discarded runs.
artifacts/vidprom_1000cache_300input/discarded_*/
artifacts/vidprom_1000cache_300input/early_signature_retry_*/
artifacts/vidprom_1000cache_300input/logs/
artifacts/vidprom_1000cache_300input/results/*/cache/
artifacts/vidprom_1000cache_300input/results/*/native/
artifacts/vidprom_1000cache_300input/results/*/vbench/
artifacts/vidprom_1000cache_300input/results/*/videos/
artifacts/vidprom_1000cache_300input/results/carnator_boundary_b5/shards/
artifacts/vidprom_1000cache_300input/results/*/requests.jsonl

# Forced-pair Early Signature calibration media and per-request payloads are
# local, regenerable outputs; keep only the compact pairs and manifest.
artifacts/vidprom_1000cache_300input/forced_early_signature_calibration/sources/
artifacts/vidprom_1000cache_300input/forced_early_signature_calibration/targets/
artifacts/vidprom_1000cache_300input/forced_early_signature_calibration/logs/
artifacts/vidprom_1000cache_300input/forced_early_signature_calibration/quality/
artifacts/vidprom_1000cache_300input/forced_early_signature_calibration/quality

# Noun-match VidProM artifacts follow the same publication boundary: retain
# source-view provenance, compact calibration selection outputs, and smoke
# audit records while leaving video/tensor/cache payloads local.
artifacts/vidprom_1000cache_300input_noun_match/source_view/entries/
artifacts/vidprom_1000cache_300input_noun_match/source_view/source_requests.csv
artifacts/vidprom_1000cache_300input_noun_match/source_view/excluded_requests.csv
artifacts/vidprom_1000cache_300input_noun_match/logs/
artifacts/vidprom_1000cache_300input_noun_match/results/*/cache/
artifacts/vidprom_1000cache_300input_noun_match/results/*/native/
artifacts/vidprom_1000cache_300input_noun_match/results/*/vbench/
artifacts/vidprom_1000cache_300input_noun_match/results/*/videos/
artifacts/vidprom_1000cache_300input_noun_match/results/carnator_boundary_b5/shards/
artifacts/vidprom_1000cache_300input_noun_match/smoke_two_requests_20260830_final_pre_forced_smoke/
artifacts/vidprom_1000cache_300input_noun_match/smoke_two_requests_20260830_final/*/cache/
artifacts/vidprom_1000cache_300input_noun_match/smoke_two_requests_20260830_final/*/native/
artifacts/vidprom_1000cache_300input_noun_match/smoke_two_requests_20260830_final/*/vbench/
artifacts/vidprom_1000cache_300input_noun_match/smoke_two_requests_20260830_final/*/videos/

# Regenerable persistent vector indexes; retrieval manifests and results remain
# publishable, while Chroma/FAISS database files do not belong in Git.
**/vector_store/
*.sqlite3

# Local source trajectories for the static Carnator figure examples are
# multi-gigabyte regenerable data.  Their compact PNG exports are tracked.
/artifacts/static-prompt-defaults/
/artifacts/static-prompt-defaults-seed*/

# Insight-figure run payloads are likewise regenerable.  Publish the figure
# PNGs, CSVs, manifests, and generation script outside this directory.
/制图/insight图/carnator_insight_experiment/runs/artifacts/

# Generated package metadata is recreated by installation.
/video_cache_baselines.egg-info/

# Third-party sources are pinned as Git submodules.  Keep their build outputs
# and local evaluator checkout out of the parent repository.
external/*/__pycache__/
external/*/.pytest_cache/
external/*/build/
external/*/dist/
external/vbench/

# The completed noun-match 300-request run is retained locally in full, but
# GitHub receives its reproducible compact audit (inputs, results, summaries,
# reports, logs, and threshold optimization) rather than multi-gigabyte media
# and evaluator/runtime payloads.
artifacts/vidprom_1000cache_300input_noun_match/early_signature_disabled_20260903_100305/*/cache/
artifacts/vidprom_1000cache_300input_noun_match/early_signature_disabled_20260903_100305/*/native/
artifacts/vidprom_1000cache_300input_noun_match/early_signature_disabled_20260903_100305/*/vbench/
artifacts/vidprom_1000cache_300input_noun_match/early_signature_disabled_20260903_100305/*/videos/

# Keep only the merged recheck audit, not evaluator input-link directories.
artifacts/vidprom_1000cache_300input_noun_match/carnator_disabled_recheck_20260906/merged/vbench/input_videos_*/

# This is a one-request mask-probe work directory. Its source trajectory,
# generated videos, and native runtime output are reproducible diagnostics.
artifacts/vidprom_1000cache_300input_noun_match/carnator_mask_probe_gpu012_20260901/source_cache_grassland/entries/
artifacts/vidprom_1000cache_300input_noun_match/carnator_mask_probe_gpu012_20260901/run/*/native/
artifacts/vidprom_1000cache_300input_noun_match/carnator_mask_probe_gpu012_20260901/run/*/videos/
artifacts/vidprom_1000cache_300input_noun_match/carnator_mask_probe_gpu012_20260901/source_view_grassland/entries/

# Acceptance reports, scores, configurations, and representative frames are
# publishable. Runtime caches, evaluator input links, and generated videos are
# retained locally and excluded from the Git repository.
artifacts/acceptance/*/*/cache/
artifacts/acceptance/*/*/videos/
artifacts/acceptance/*/*/vbench/input_videos_*/
artifacts/acceptance/*/shared_cache/source.mp4
artifacts/acceptance/*/ti2v-5b/*/*/videos/

# Diagnostic VBench input videos merely link to the retained 300-request run.
artifacts/vidprom_1000cache_300input_noun_match/early_signature_disabled_20260903_100305/diagnostics/*/vbench/input_videos_*/

# Archived logs, superseded scripts, and docs merged into docs/. Local reference
# only; nothing here is part of the published repository state.
/_archive/

# Carnator single-request ablation: publish the design docs, summary, and quality
# metrics; videos, caches, and per-variant run logs are regenerable locally.
artifacts/ablation_req16_*/*/ablation/videos/
artifacts/ablation_req16_*/*/ablation/cache/
artifacts/ablation_req16_*/vbench/
artifacts/ablation_req16_*/*/run.log

# CogVideoX 10-sample and fusion-mask diagnostics. Keep the compact
# results.jsonl and driver logs; the generated videos, temporary caches, and
# source-preparation payloads stay local.
artifacts/cogvideox15_10samples_test/*/videos/
artifacts/cogvideox15_10samples_test/*/cache/
artifacts/cogvideox15_5baselines_10samples/*/videos/
artifacts/cogvideox15_5baselines_10samples/*/cache/
artifacts/cogvideox15_5baselines_10samples/*/tmp_cache/
artifacts/cogvideox15_5baselines_10samples/*/source_prepare/
artifacts/fusion_mask_experiment_*/*/videos/
artifacts/fusion_mask_experiment_*/*/cache/
artifacts/fusion_mask_experiment_*/*/tmp_cache/
artifacts/fusion_mask_experiment_*/*/source_prepare/

# Mask overlay PNGs are a local diagnostic rendering, not a published result.
artifacts/mask_visualization_carnator/

# Wan2.1 run logs are append-only operational history; results.jsonl and the
# aggregation outputs are the durable records.
artifacts/wan21_experiment_logs/
artifacts/wan21_rerun_logs/

# Wan2.1 replay runs: keep results.jsonl, summaries, and reports; the 600MB of
# generated videos, temporary caches, and VBench evaluator payloads stay local.
artifacts/vidprom_1000cache_300input_noun_match/results_wan21_*/*/videos/
artifacts/vidprom_1000cache_300input_noun_match/results_wan21_*/*/cache/
artifacts/vidprom_1000cache_300input_noun_match/results_wan21_*/*/tmp_cache/
artifacts/vidprom_1000cache_300input_noun_match/results_wan21_*/*/native/
artifacts/vidprom_1000cache_300input_noun_match/results_wan21_*/*/vbench/
artifacts/vidprom_1000cache_300input_noun_match/results_wan21_*/*/source_prepare/

# LTX-Video replay runs follow the same publication boundary as the Wan2.1 ones:
# keep requests.jsonl, the compact audits and the aggregation outputs; the
# generated videos, temporary caches, and VBench evaluator payloads stay local.
# The wildcard is deliberately suffix-less so that it covers both the 10-request
# smoke directory (results_ltxvideo_test) and the formal 300-request one
# (results_ltxvideo); the earlier results_ltxvideo_* form silently missed the
# latter's ~700MB of videos.
artifacts/vidprom_1000cache_300input_noun_match/results_ltxvideo*/*/videos/
artifacts/vidprom_1000cache_300input_noun_match/results_ltxvideo*/*/cache/
artifacts/vidprom_1000cache_300input_noun_match/results_ltxvideo*/*/tmp_cache/
artifacts/vidprom_1000cache_300input_noun_match/results_ltxvideo*/*/native/
artifacts/vidprom_1000cache_300input_noun_match/results_ltxvideo*/*/vbench/
artifacts/vidprom_1000cache_300input_noun_match/results_ltxvideo*/*/source_prepare/

# CogVideoX replay runs use the same boundary.  Only their 10-request smoke
# results and the 3-request adapter payloads had rules before; the 300-request
# directory name (results_cogvideox15_test) matched neither.
artifacts/vidprom_1000cache_300input_noun_match/results_cogvideox15_*/*/videos/
artifacts/vidprom_1000cache_300input_noun_match/results_cogvideox15_*/*/cache/
artifacts/vidprom_1000cache_300input_noun_match/results_cogvideox15_*/*/tmp_cache/
artifacts/vidprom_1000cache_300input_noun_match/results_cogvideox15_*/*/native/
artifacts/vidprom_1000cache_300input_noun_match/results_cogvideox15_*/*/vbench/
artifacts/vidprom_1000cache_300input_noun_match/results_cogvideox15_*/*/source_prepare/

# CogVideoX run logs, as for Wan2.1 and LTX-Video.
artifacts/cogvideox15_experiment_logs/

# LTX run logs are append-only operational history, as the Wan2.1 ones are.
artifacts/ltxvideo_experiment_logs/

# CogVideoX 3-request adapter test payloads.
artifacts/vidprom_1000cache_300input_noun_match/cogvideox15_3req_test_*/*/videos/
artifacts/vidprom_1000cache_300input_noun_match/cogvideox15_3req_test_*/*/cache/
artifacts/vidprom_1000cache_300input_noun_match/cogvideox15_3req_test_*/*/tmp_cache/
artifacts/vidprom_1000cache_300input_noun_match/cogvideox15_3req_test_*/*/native/
artifacts/vidprom_1000cache_300input_noun_match/cogvideox15_3req_test_*/*/vbench/

# CogVideoX environment overlay: symlinks to the handful of packages (chiefly
# supervision, for Grounded-SAM-2) that the cogvideo env lacks and that would
# otherwise only arrive via the user site-packages.  PYTHONNOUSERSITE=1 is
# mandatory for CogVideoX runs, so that path is closed off; the overlay carries
# exactly the missing packages and nothing that could shadow the environment.
.cogvideo_overlay/
