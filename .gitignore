# Python bytecode and test tooling
__pycache__/
*.py[cod]
.pytest_cache/

# Local environments and editor files
.venv/
venv/
.env
.env.*
.idea/
.vscode/

# Downloaded model weights and large tensor/checkpoint payloads
/models/
*.pt
*.pth
*.ckpt
*.safetensors
*.bin
*.latent

# Regenerable runtime caches. Keep run outputs, reports, and videos tracked.
artifacts/cache/
**/cache/
artifacts/vbench-cache/

# Third-party sources are pinned as Git submodules.  Keep their build outputs
# and local evaluator checkout out of the parent repository.
external/*/__pycache__/
external/*/.pytest_cache/
external/*/build/
external/*/dist/
external/vbench/
